{
  "name": "@whybebabo/dsh-code-nav",
  "version": "0.4.0",
  "description": "DSH web plugin (dsh-better-sidebar companion): code and config file preview with per-language syntax highlighting, symbol outline navigation (class / method / variable, JSON/YAML/TOML/XML keys), in-file search and selection -> clickable quote chip in the conversation.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js",
    "test": "node --check lib/client.js && node --check lib/index.js && node --test",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "npm test",
    "release": "node scripts/release-code-nav.mjs --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whybebabo/dsh-code-nav.git"
  },
  "homepage": "https://github.com/whybebabo/dsh-code-nav#readme",
  "bugs": {
    "url": "https://github.com/whybebabo/dsh-code-nav/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "better-sidebar",
    "code",
    "preview",
    "syntax-highlight",
    "outline",
    "search",
    "selection",
    "conversation"
  ],
  "license": "MIT"
}
