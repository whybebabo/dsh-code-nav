{
  "name": "@whybebabo/dsh-code-nav",
  "version": "0.1.1",
  "description": "DSH web plugin (dsh-better-sidebar companion): code file preview with per-language syntax highlighting, symbol outline navigation (class / method / variable), in-file search and selection -> add to conversation. Fork of AnakinCao/dsh-code-nav.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whybebabo/dsh-code-nav.git"
  },
  "homepage": "https://github.com/whybebabo/dsh-code-nav#readme",
  "bugs": {
    "url": "https://github.com/whybebabo/dsh-code-nav/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "better-sidebar",
    "code",
    "preview",
    "syntax-highlight",
    "outline",
    "search",
    "selection",
    "conversation"
  ],
  "license": "MIT"
}
